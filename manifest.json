{
  "manifest_version": 3,
  "name": "Flow - Strict Focus Timer",
  "version": "1.0",
  "description": "Stay locked in. AI-powered focus timer that pauses when you look away or pick up your phone.",
  "icons": {
    "16": "icons/icon16.png"
  },
  

  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}